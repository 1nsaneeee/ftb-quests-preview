{
  "name": "ftb-quests-preview",
  "version": "0.1.1",
  "description": "Local FTB Quests preview/editor with an AI-first CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/1nsaneeee/ftb-quests-preview.git"
  },
  "homepage": "https://github.com/1nsaneeee/ftb-quests-preview#readme",
  "bugs": {
    "url": "https://github.com/1nsaneeee/ftb-quests-preview/issues"
  },
  "type": "module",
  "main": "./server/store.mjs",
  "exports": {
    ".": "./server/store.mjs",
    "./store": "./server/store.mjs",
    "./lint": "./server/lint.mjs",
    "./schema": "./server/schema.mjs",
    "./save-service": "./server/save-service.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "ftbquest": "cli.mjs",
    "ftbquest-preview": "preview.mjs"
  },
  "files": [
    "app.js",
    "index.html",
    "setup.html",
    "setup.js",
    "styles.css",
    "cli.mjs",
    "server.mjs",
    "preview.mjs",
    "install.mjs",
    "parse-snbt.mjs",
    "quest-preview.example.json",
    "components/",
    "lib/",
    "server/",
    "styles/",
    "fixtures/",
    "skills/",
    "AGENTS.md",
    "ARCHITECTURE.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "minecraft",
    "ftb-quests",
    "snbt",
    "quest-editor",
    "cli"
  ],
  "scripts": {
    "start": "node preview.mjs",
    "serve": "node preview.mjs",
    "setup": "node install.mjs",
    "cli": "node cli.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test",
    "prepublishOnly": "npm run check && npm test"
  },
  "engines": {
    "node": ">=20"
  }
}
